# Copy to `.env` / `.env.local` and adjust.

# Spring REST API — base URL including `/api` (no trailing slash required).
# Either name works; NEXT_PUBLIC_API_URL takes precedence over API_URL at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# API_URL=http://localhost:8080/api

NEXT_PUBLIC_SITE_URL=http://localhost:4028
